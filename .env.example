# ==============================================================================
# 「看得见的声音」环境变量示例（复制为 .env 使用，.env 已在 .gitignore 中忽略）
# 未设置的变量均使用注释中的默认值（见 backend/app/config.py）
# ==============================================================================

# --- 真人标准音节语料库路径（CORPUS_DIR 或 SVS_CORPUS_DIR，运行 python seed.py 必填） ---
# 目录内须包含 FV1, FV2, FV3, MV1, MV2, MV3 六个发音人子目录（<pinyin><tone>_<SPK>.wav）
# 支持绝对路径或相对本仓库根目录的路径，例如 ../录音
CORPUS_DIR=../录音

# --- 服务监听与运行环境 ---
# SVS_ENV=dev        # dev | prod（prod 下 Cookie 附加 Secure）
# SVS_HOST=127.0.0.1
# SVS_PORT=8000
# SVS_DATA_DIR=      # 数据目录（SQLite、私有录音、媒体），默认 backend/data

# --- 跨域与 CSRF ---
# 同源部署填本站地址；开发环境默认追加前端 dev server 源（逗号分隔）
# SVS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# SVS_CSRF_ENFORCED=1   # 写请求 Origin 校验开关，置 0 关闭（仅本地调试用）

# --- 维护后台口令（/admin） ---
# SVS_ADMIN_USERNAME=admin
# SVS_ADMIN_PASSWORD=admin12345

# --- 评分服务 Provider（默认 xfyun 讯飞真实评测；测试/离线时显式设为 mock） ---
# SVS_PROVIDER=xfyun
# 讯飞流式评测凭据（控制台 https://console.xfyun.cn 获取；默认 Provider 即需要）
# XFYUN_APP_ID=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=
# XFYUN_WS_URL=wss://ise-api.xfyun.cn/v2/open-ise
# XFYUN_CATEGORY=read_syllable   # 题型：read_syllable | read_word | read_sentence | read_chapter
# XFYUN_TIMEOUT_SEC=20           # 单次评测整体预算（检测管线硬截止 30s）

# --- mock Provider 故障注入（仅 SVS_PROVIDER=mock 时生效；测试用，平时保持注释） ---
# SVS_MOCK_PROVIDER=fail   # fail=模拟不可达 / disordered=乱读 / missing=漏读 / slow=强制慢响应
# SVS_MOCK_SLOW_SEC=3      # slow 模式强制等待秒数（> SVS_HARD_DEADLINE 可演练超时调度）

# --- F0 管线纠偏开关（默认全开；同批录音对比评测定参用） ---
# SVS_F0_RESCUE=0    # 关闭嘎裂/弱周期恢复（Creaky Rescue Pass）
# SVS_F0_CORRECT=0   # 关闭跳变检测与候选路径纠偏
# SVS_F0_INTERP=0    # 关闭 ≤2 帧毛刺缺口半音域插值

# --- 检测调度与执行器 ---
# SVS_SYNC_WINDOW=8           # 同步等待窗口（秒），未完成返回 202 供轮询
# SVS_HARD_DEADLINE=30        # 录音检测自受理起硬截止（秒）
# SVS_CALIBRATION_TIMEOUT=45  # 标定路由等待上限（秒，与录音硬截止解耦）
# SVS_EXECUTOR_WORKERS=4      # 进程内执行器线程数
# SVS_EXECUTOR_QUEUE=32       # 执行器队列上限（满时提交返回 SERVER_BUSY）
