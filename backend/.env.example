# ============================================================
# backend/.env.example —— LLM 接入配置模板
# 用法：复制为 backend/.env 后填入自己的值；.env 已被 .gitignore 忽略。
#
# 命名规则：LLM_<PROFILE>_<字段>
#   · profile 名大写，"-" 和 "." 转 "_"（如 profile="qwen-vl" → LLM_QWEN_VL_*）
#   · 非 default 的 profile 若某项没配，自动回退到 LLM_DEFAULT_<X>
#   · 系统环境变量优先于本文件（加载时 override=False）
#
# 每个档可用的字段（全部可选，均有代码内默认值）：
#   _BASE_URL            必填，OpenAI 兼容端点（含 /v1）
#   _API_KEY             必填（本地端点可任意占位，如 ollama）
#   _MODEL               必填，模型名
#   _TEMPERATURE         默认 0.7
#   _MAX_TOKENS          默认不下发
#   _TIMEOUT             秒，默认 120
#   _IMAGE_MAX_SIDE      图像降采样最长边（像素），默认不降采样
#   _JSON_MAX_RETRIES    结构化输出校验失败重试次数，默认 1（0 = 不重试）
#   _JSON_ALLOW_STRICT   是否允许 json_schema strict 模式，默认 true
#                        （1/0、true/false、yes/no、on/off 均可）
#
# LLM_PROFILE：业务代码未指定 profile 时使用的档名（默认 "default"）。
#   例如设为 local 后，所有不指定档的调用都走 LLM_LOCAL_*。
# ============================================================

# ---- 默认档：便宜快速的纯文本模型 ----
LLM_DEFAULT_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_API_KEY=sk-替换成你自己的Key
LLM_DEFAULT_MODEL=deepseek-chat
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_TIMEOUT=120
# LLM_DEFAULT_IMAGE_MAX_SIDE=1024
# LLM_DEFAULT_JSON_MAX_RETRIES=1
# LLM_DEFAULT_JSON_ALLOW_STRICT=true

# ---- 默认档选择：不写则业务代码里的调用走 default 档 ----
# LLM_PROFILE=local

# ---- 视觉档：看语谱图做诊断（可用阿里云百炼 / OpenRouter 等 OpenAI 兼容端点）----
# LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_VISION_API_KEY=sk-替换成你自己的Key
# LLM_VISION_MODEL=qwen-vl-max
# LLM_VISION_TIMEOUT=180
# LLM_VISION_IMAGE_MAX_SIDE=1024

# ---- 本地档：Ollama 的 OpenAI 兼容端点（无需真实 Key，本机即可自测）----
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=qwen2.5:3b
LLM_LOCAL_TIMEOUT=180
# LLM_LOCAL_JSON_MAX_RETRIES=2
# LLM_LOCAL_JSON_ALLOW_STRICT=false

# ---- 结构化输出档（可指向支持 json_schema 的模型）----
# LLM_JSON_BASE_URL=https://api.openai.com/v1
# LLM_JSON_API_KEY=sk-替换成你自己的Key
# LLM_JSON_MODEL=gpt-4o-mini
